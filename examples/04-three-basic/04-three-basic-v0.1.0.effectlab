  "entry": "index.html",
  "parameters": [
    {
      "id": "speed",
      "label": "Velocidad",
      "widget": "slider",
      "value": 1,
      "defaultValue": 1,
      "min": 0,
      "max": 5,
      "step": 0.1,
      "binding": "speed",
      "source": "code"
    },
    {
      "id": "color",
      "label": "Color",
      "widget": "color",
      "value": "#8b5cf6",
      "defaultValue": "#8b5cf6",
      "step": 1,
      "binding": "color",
      "source": "code"
