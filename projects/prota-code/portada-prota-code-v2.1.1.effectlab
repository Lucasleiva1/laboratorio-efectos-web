  "description": "La portada se reconstruye con partículas de la imagen original. El movimiento las dispersa; al quedarse quieto vuelven a su posición.",
  "files": [
    {
      "path": "index.html",
      "content": "<section aria-labelledby=\"portada\"><div class=\"container\"><div class=\"copy\"><p class=\"eyebrow\"></p><h1 id=\"portada\"></h1><p class=\"description\"></p><div class=\"actions\"><button class=\"primary\"><span></span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button><button class=\"secondary\"></button></div></div></div></section><link rel=\"stylesheet\" href=\"style.css\"><script type=\"module\" src=\"main.js\"></script>"
    },
    {
      "path": "style.css",
      "content": "*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent}body{font-family:Barlow,Arial,sans-serif;color:var(--textColor);-webkit-font-smoothing:antialiased}section{height:100%;position:relative}.container{height:100%;width:100%;max-width:1400px;margin:auto;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(160px,38vh,300px) 16px 40px}.copy{min-width:0;max-width:576px;transform:translate(var(--offsetX),var(--offsetY));transform-origin:left center}.eyebrow{margin:0;font:500 calc(11px * var(--textScale))/1.5 'Barlow Condensed',sans-serif;letter-spacing:.18em;text-transform:uppercase;color:var(--mutedColor)}h1{margin:16px 0 0;font:600 calc(34.4px * var(--textScale))/.95 'Barlow Condensed',sans-serif;letter-spacing:-.015em;text-wrap:balance;overflow-wrap:anywhere}.description{margin:20px 0 0;max-width:448px;font-size:calc(16px * var(--textScale));line-height:1.625;color:var(--mutedColor)}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:28px}button{display:inline-flex;align-items:center;gap:8px;padding:12px 24px;font:500 calc(14px * var(--textScale))/20px Barlow,sans-serif;cursor:pointer;border:1px solid transparent}.primary{background:var(--accentColor);color:#111827}.secondary{border-color:#2c3a4f;color:var(--textColor);background:transparent}button:hover{filter:brightness(1.12)}button:focus-visible{outline:2px solid #f0a66b;outline-offset:3px}@media(min-width:640px){.container{padding:clamp(120px,30vh,260px) 24px 48px}h1{font-size:calc(48px * var(--textScale));margin-top:20px}.description{margin-top:24px;font-size:calc(18px * var(--textScale))}.actions{margin-top:32px}}@media(min-width:990px){.container{justify-content:center;padding:64px 40px}.copy{max-width:384px}h1{font-size:calc(42.4px * var(--textScale))}}@media(min-width:1280px){.copy{max-width:448px}h1{font-size:calc(48px * var(--textScale))}}@media(min-width:1536px){h1{font-size:calc(60px * var(--textScale))}}"
    },
    {
      "path": "main.js",
      "content": "import font0 from './assets/barlow-400.woff2';\nimport font1 from './assets/barlow-500.woff2';\nimport font2 from './assets/barlow-condensed-500.woff2';\nimport font3 from './assets/barlow-condensed-600.woff2';\nconst style=document.createElement('style');style.textContent=[`@font-face{font-family:\"Barlow\";font-weight:400;font-style:normal;font-display:swap;src:url(\"${font0}\") format(\"woff2\")}`,`@font-face{font-family:\"Barlow\";font-weight:500;font-style:normal;font-display:swap;src:url(\"${font1}\") format(\"woff2\")}`,`@font-face{font-family:\"Barlow Condensed\";font-weight:500;font-style:normal;font-display:swap;src:url(\"${font2}\") format(\"woff2\")}`,`@font-face{font-family:\"Barlow Condensed\";font-weight:600;font-style:normal;font-display:swap;src:url(\"${font3}\") format(\"woff2\")}`].join('');document.head.append(style);\nlab.register([{\"id\":\"eyebrow\",\"binding\":\"eyebrow\",\"label\":\"Texto superior\",\"value\":\"Programas de escritorio · Pago único\",\"defaultValue\":\"Programas de escritorio · Pago único\",\"widget\":\"text\",\"source\":\"code\"},{\"id\":\"headline\",\"binding\":\"headline\",\"label\":\"Título\",\"value\":\"Herramientas que se compran una vez.\",\"defaultValue\":\"Herramientas que se compran una vez.\",\"widget\":\"text\",\"source\":\"code\"},{\"id\":\"description\",\"binding\":\"description\",\"label\":\"Descripción\",\"value\":\"Pagás, descargás y las usás. La versión que comprás queda tuya de forma permanente, sin cuotas todos los meses.\",\"defaultValue\":\"Pagás, descargás y las usás. La versión que comprás queda tuya de forma permanente, sin cuotas todos los meses.\",\"widget\":\"text\",\"source\":\"code\"},{\"id\":\"primary\",\"binding\":\"primary\",\"label\":\"Botón principal\",\"value\":\"Ver programas\",\"defaultValue\":\"Ver programas\",\"widget\":\"text\",\"source\":\"code\"},{\"id\":\"secondary\",\"binding\":\"secondary\",\"label\":\"Botón secundario\",\"value\":\"Cómo funciona\",\"defaultValue\":\"Cómo funciona\",\"widget\":\"text\",\"source\":\"code\"},{\"id\":\"textColor\",\"binding\":\"textColor\",\"label\":\"Color del título\",\"value\":\"#eef2f7\",\"defaultValue\":\"#eef2f7\",\"widget\":\"color\",\"source\":\"code\"},{\"id\":\"mutedColor\",\"binding\":\"mutedColor\",\"label\":\"Color de descripción\",\"value\":\"#94a3b8\",\"defaultValue\":\"#94a3b8\",\"widget\":\"color\",\"source\":\"code\"},{\"id\":\"accentColor\",\"binding\":\"accentColor\",\"label\":\"Color del botón\",\"value\":\"#d47a42\",\"defaultValue\":\"#d47a42\",\"widget\":\"color\",\"source\":\"code\"},{\"id\":\"textScale\",\"binding\":\"textScale\",\"label\":\"Tamaño de los textos\",\"value\":1,\"defaultValue\":1,\"widget\":\"slider\",\"source\":\"code\",\"min\":0.7,\"max\":1.4,\"step\":0.05},{\"id\":\"offsetX\",\"binding\":\"offsetX\",\"label\":\"Desplazamiento horizontal (px)\",\"value\":0,\"defaultValue\":0,\"widget\":\"slider\",\"source\":\"code\",\"min\":-150,\"max\":150,\"step\":1},{\"id\":\"offsetY\",\"binding\":\"offsetY\",\"label\":\"Desplazamiento vertical (px)\",\"value\":0,\"defaultValue\":0,\"widget\":\"slider\",\"source\":\"code\",\"min\":-150,\"max\":150,\"step\":1}],p=>{for(const [id,selector] of Object.entries({eyebrow:'.eyebrow',headline:'h1',description:'.description',primary:'.primary span',secondary:'.secondary'}))document.querySelector(selector).textContent=p[id];for(const key of ['textColor','mutedColor','accentColor','textScale'])document.documentElement.style.setProperty('--'+key,p[key]);for(const key of ['offsetX','offsetY'])document.documentElement.style.setProperty('--'+key,p[key]+'px');});\ndocument.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>console.info('Vista de laboratorio: '+b.textContent.trim())));"
    },
    {
      "path": "parameters.json",
      "content": "[\n  {\n    \"id\": \"eyebrow\",\n    \"binding\": \"eyebrow\",\n    \"label\": \"Texto superior\",\n    \"value\": \"Programas de escritorio · Pago único\",\n    \"defaultValue\": \"Programas de escritorio · Pago único\",\n    \"widget\": \"text\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"headline\",\n    \"binding\": \"headline\",\n    \"label\": \"Título\",\n    \"value\": \"Herramientas que se compran una vez.\",\n    \"defaultValue\": \"Herramientas que se compran una vez.\",\n    \"widget\": \"text\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"description\",\n    \"binding\": \"description\",\n    \"label\": \"Descripción\",\n    \"value\": \"Pagás, descargás y las usás. La versión que comprás queda tuya de forma permanente, sin cuotas todos los meses.\",\n    \"defaultValue\": \"Pagás, descargás y las usás. La versión que comprás queda tuya de forma permanente, sin cuotas todos los meses.\",\n    \"widget\": \"text\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"primary\",\n    \"binding\": \"primary\",\n    \"label\": \"Botón principal\",\n    \"value\": \"Ver programas\",\n    \"defaultValue\": \"Ver programas\",\n    \"widget\": \"text\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"secondary\",\n    \"binding\": \"secondary\",\n    \"label\": \"Botón secundario\",\n    \"value\": \"Cómo funciona\",\n    \"defaultValue\": \"Cómo funciona\",\n    \"widget\": \"text\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"textColor\",\n    \"binding\": \"textColor\",\n    \"label\": \"Color del título\",\n    \"value\": \"#eef2f7\",\n    \"defaultValue\": \"#eef2f7\",\n    \"widget\": \"color\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"mutedColor\",\n    \"binding\": \"mutedColor\",\n    \"label\": \"Color de descripción\",\n    \"value\": \"#94a3b8\",\n    \"defaultValue\": \"#94a3b8\",\n    \"widget\": \"color\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"accentColor\",\n    \"binding\": \"accentColor\",\n    \"label\": \"Color del botón\",\n    \"value\": \"#d47a42\",\n    \"defaultValue\": \"#d47a42\",\n    \"widget\": \"color\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"textScale\",\n    \"binding\": \"textScale\",\n    \"label\": \"Tamaño de los textos\",\n    \"value\": 1,\n    \"defaultValue\": 1,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": 0.7,\n    \"max\": 1.4,\n    \"step\": 0.05\n  },\n  {\n    \"id\": \"offsetX\",\n    \"binding\": \"offsetX\",\n    \"label\": \"Desplazamiento horizontal (px)\",\n    \"value\": 0,\n    \"defaultValue\": 0,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": -150,\n    \"max\": 150,\n    \"step\": 1\n  },\n  {\n    \"id\": \"offsetY\",\n    \"binding\": \"offsetY\",\n    \"label\": \"Desplazamiento vertical (px)\",\n    \"value\": 0,\n    \"defaultValue\": 0,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": -150,\n    \"max\": 150,\n    \"step\": 1\n  }\n]"
    },
    {
      "path": "assets/barlow-400.woff2",
      "content": "data:font/woff2;base64,"
