          "files": [
            {
              "path": "index.html",
              "content": "<img id=\"cover\" alt=\"Caja de Prota Code sobre una tarima iluminada, rodeada de pantallas de aplicaciones.\"><link rel=\"stylesheet\" href=\"style.css\"><script type=\"module\" src=\"main.js\"></script>"
            },
            {
              "path": "style.css",
              "content": "*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent}body{background:#111827}img{display:block;width:100%;height:100%;object-fit:cover;object-position:var(--positionX) var(--positionY);transform:scale(var(--zoom));filter:brightness(var(--brightness))}body[data-responsive=\"true\"] img{object-position:85% top}@media(min-width:640px){body[data-responsive=\"true\"] img{object-position:70% center}}@media(min-width:990px){body[data-responsive=\"true\"] img{object-position:62% 65%}}@media(min-width:1280px){body[data-responsive=\"true\"] img{object-position:58% 55%}}"
            },
            {
              "path": "main.js",
              "content": "import image from './assets/portada.png';document.querySelector('#cover').src=image;lab.register([{\"id\":\"zoom\",\"binding\":\"zoom\",\"label\":\"Zoom de imagen\",\"value\":1,\"defaultValue\":1,\"widget\":\"slider\",\"source\":\"code\",\"min\":1,\"max\":1.6,\"step\":0.01},{\"id\":\"positionX\",\"binding\":\"positionX\",\"label\":\"Encuadre horizontal (%)\",\"value\":62,\"defaultValue\":62,\"widget\":\"slider\",\"source\":\"code\",\"min\":0,\"max\":100,\"step\":1},{\"id\":\"positionY\",\"binding\":\"positionY\",\"label\":\"Encuadre vertical (%)\",\"value\":65,\"defaultValue\":65,\"widget\":\"slider\",\"source\":\"code\",\"min\":0,\"max\":100,\"step\":1},{\"id\":\"brightness\",\"binding\":\"brightness\",\"label\":\"Luminosidad\",\"value\":1,\"defaultValue\":1,\"widget\":\"slider\",\"source\":\"code\",\"min\":0.2,\"max\":1.5,\"step\":0.05},{\"id\":\"responsive\",\"binding\":\"responsive\",\"label\":\"Encuadre original adaptable\",\"value\":true,\"defaultValue\":true,\"widget\":\"toggle\",\"source\":\"code\"}],p=>{document.body.dataset.responsive=String(p.responsive);const s=document.documentElement.style;s.setProperty('--positionX',p.positionX+'%');s.setProperty('--positionY',p.positionY+'%');s.setProperty('--zoom',p.zoom);s.setProperty('--brightness',p.brightness);});"
            },
            {
              "path": "parameters.json",
              "content": "[\n  {\n    \"id\": \"zoom\",\n    \"binding\": \"zoom\",\n    \"label\": \"Zoom de imagen\",\n    \"value\": 1,\n    \"defaultValue\": 1,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": 1,\n    \"max\": 1.6,\n    \"step\": 0.01\n  },\n  {\n    \"id\": \"positionX\",\n    \"binding\": \"positionX\",\n    \"label\": \"Encuadre horizontal (%)\",\n    \"value\": 62,\n    \"defaultValue\": 62,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": 0,\n    \"max\": 100,\n    \"step\": 1\n  },\n  {\n    \"id\": \"positionY\",\n    \"binding\": \"positionY\",\n    \"label\": \"Encuadre vertical (%)\",\n    \"value\": 65,\n    \"defaultValue\": 65,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": 0,\n    \"max\": 100,\n    \"step\": 1\n  },\n  {\n    \"id\": \"brightness\",\n    \"binding\": \"brightness\",\n    \"label\": \"Luminosidad\",\n    \"value\": 1,\n    \"defaultValue\": 1,\n    \"widget\": \"slider\",\n    \"source\": \"code\",\n    \"min\": 0.2,\n    \"max\": 1.5,\n    \"step\": 0.05\n  },\n  {\n    \"id\": \"responsive\",\n    \"binding\": \"responsive\",\n    \"label\": \"Encuadre original adaptable\",\n    \"value\": true,\n    \"defaultValue\": true,\n    \"widget\": \"toggle\",\n    \"source\": \"code\"\n  }\n]"
            },
