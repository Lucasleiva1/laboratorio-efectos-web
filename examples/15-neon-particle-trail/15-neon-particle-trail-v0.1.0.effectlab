  "description": "Partículas diminutas, estela del cursor y onda expansiva de puntos al hacer clic. Pool fijo y dos pasadas de dibujo, sin malla ni desenfoque.",
  "files": [
    {
      "path": "index.html",
      "content": "<canvas id=\"network\" aria-label=\"Red tecnológica interactiva\"></canvas><link rel=\"stylesheet\" href=\"style.css\"><script type=\"module\" src=\"main.js\"></script>"
    },
    {
      "path": "style.css",
      "content": "html,body{width:100%;height:100%;margin:0;overflow:hidden;background:transparent}canvas{display:block;width:100%;height:100%;touch-action:none}"
    },
    {
      "path": "main.js",
      "content": "import schema from \"./parameters.json\";\nconst canvas = document.querySelector(\"#network\");\nconst ctx = canvas.getContext(\"2d\", { desynchronized: true });\n// Fixed pool: no growing particle arrays, no mesh and no per-particle blur.\nconst pool = Array.from({ length: 240 }, () => ({\n  alive: false,\n  x: 0,\n  y: 0,\n  vx: 0,\n  vy: 0,\n  born: 0,\n  life: 1,\n}));\nlet p = {},\n  cursor = null,\n  head = 0,\n  waves = [],\n  time = 0,\n  previous = performance.now(),\n  raf;\nlet w = 1,\n  h = 1,\n  dirty = true,\n  frames = 0,\n  cost = 0,\n  measuredAt = performance.now();\nfunction resize() {\n  w = innerWidth;\n  h = innerHeight;\n  canvas.width = Math.round(w);\n  canvas.height = Math.round(h);\n  dirty = true;\n  wake();\n}\nwindow.lab.register(schema, (value) => {\n  p = value;\n  head %= p.count;\n  if (!p.ripples) waves = [];\n  dirty = true;\n  canvas.dataset.color = p.color;\n  wake();\n});\nresize();\naddEventListener(\"resize\", resize);\nfunction spawn(x, y) {\n  const particle = pool[head];\n  head = (head + 1) % p.count;\n  const angle = Math.random() * Math.PI * 2,\n    speed = p.drift * (0.25 + Math.random() * 0.75);\n  Object.assign(particle, {\n    alive: true,\n    x: x + (Math.random() - 0.5) * p.spread,\n    y: y + (Math.random() - 0.5) * p.spread,\n    vx: Math.cos(angle) * speed,\n    vy: Math.sin(angle) * speed,\n    born: time,\n    life: p.life * (0.6 + Math.random() * 0.4),\n  });\n}\nfunction move(e) {\n  if (window.lab.paused) return;\n  const from = cursor ?? { x: e.clientX, y: e.clientY };\n  const dx = e.clientX - from.x,\n    dy = e.clientY - from.y;\n  const steps = Math.min(16, Math.max(1, Math.ceil(Math.hypot(dx, dy) / 4)));\n  for (let i = 1; i <= steps; i++) {\n    spawn(from.x + (dx * i) / steps, from.y + (dy * i) / steps);\n    spawn(from.x + (dx * i) / steps, from.y + (dy * i) / steps);\n  }\n  cursor = { x: e.clientX, y: e.clientY };\n  dirty = true;\n  wake();\n}\nfunction click(e) {\n  if (e.button !== 0 || window.lab.paused) return;\n  for (let i = 0; i < 14; i++) spawn(e.clientX, e.clientY);\n  if (p.ripples) {\n    waves.push({ x: e.clientX, y: e.clientY, born: time });\n    if (waves.length > 3) waves.shift();\n  }\n  dirty = true;\n  wake();\n}\nfunction leave() {\n  cursor = null;\n}\ncanvas.addEventListener(\"pointermove\", move);\ncanvas.addEventListener(\"pointerdown\", click);\ncanvas.addEventListener(\"pointerleave\", leave);\nfunction wake() {\n  if (!raf) {\n    previous = performance.now();\n    measuredAt = previous;\n    frames = 0;\n    cost = 0;\n    raf = requestAnimationFrame(tick);\n  }\n}\nfunction pauseChanged() {\n  wake();\n}\nwindow.addEventListener(\"lab:pause\", pauseChanged);\nfunction tick(now) {\n  raf = 0;\n  const started = performance.now(),\n    dt = Math.min(0.04, (now - previous) / 1000);\n  previous = now;\n  if (!window.lab.paused) time += dt;\n  waves = waves.filter((wave) => time - wave.born < 2.6);\n  let active = 0;\n  const dots = new Path2D(),\n    halos = new Path2D();\n  function dot(x, y, alpha) {\n    const radius = p.size * Math.max(0.25, alpha);\n    dots.moveTo(x + radius, y);\n    dots.arc(x, y, radius, 0, Math.PI * 2);\n    if (p.glow > 0) {\n      const halo = radius * (1 + p.glow * 2);\n      halos.moveTo(x + halo, y);\n      halos.arc(x, y, halo, 0, Math.PI * 2);\n    }\n  }\n  for (let i = 0; i < p.count; i++) {\n    const particle = pool[i];\n    if (!particle.alive) continue;\n    const age = (time - particle.born) / particle.life;\n    if (age >= 1) {\n      particle.alive = false;\n      continue;\n    }\n    active++;\n    if (!window.lab.paused) {\n      particle.x += particle.vx * dt;\n      particle.y += particle.vy * dt;\n    }\n    let x = particle.x,\n      y = particle.y;\n    for (const wave of waves) {\n      const dx = x - wave.x,\n        dy = y - wave.y,\n        distance = Math.sqrt(dx * dx + dy * dy),\n        band = distance - (time - wave.born) * p.waveSpeed;\n      if (Math.abs(band) < 35 && distance > 0.1) {\n        const push =\n          Math.sin(band * 0.1) * (1 - Math.abs(band) / 35) * p.waveForce;\n        x += (dx / distance) * push;\n        y += (dy / distance) * push;\n      }\n    }\n    dot(x, y, (1 - age) * (1 - age));\n  }\n  for (const wave of waves) {\n    const age = time - wave.born,\n      radius = age * p.waveSpeed,\n      fade = 1 - age / 2.6;\n    for (let i = 0; i < 40; i++) {\n      const angle = (i * Math.PI * 2) / 40;\n      dot(\n        wave.x + Math.cos(angle) * radius,\n        wave.y + Math.sin(angle) * radius,\n        fade * 0.8,\n      );\n    }\n  }\n  if (dirty || active || waves.length) {\n    ctx.clearRect(0, 0, w, h);\n    ctx.fillStyle = p.color;\n    if (p.glow > 0) {\n      ctx.globalAlpha = 0.12 * p.glow * p.intensity;\n      ctx.fill(halos);\n    }\n    ctx.globalAlpha = p.intensity;\n    ctx.fill(dots);\n    ctx.globalAlpha = 1;\n    dirty = Boolean(active || waves.length);\n  }\n  frames++;\n  cost += performance.now() - started;\n  if (now - measuredAt >= 1000) {\n    canvas.dataset.fps = ((frames * 1000) / (now - measuredAt)).toFixed(1);\n    canvas.dataset.drawMs = (cost / frames).toFixed(2);\n    frames = 0;\n    cost = 0;\n    measuredAt = now;\n  }\n  canvas.dataset.particles = String(active);\n  canvas.dataset.ripples = String(waves.length);\n  if (!window.lab.paused && (active || waves.length || dirty))\n    raf = requestAnimationFrame(tick);\n}\nwake();\nwindow.lab.onDispose(() => {\n  cancelAnimationFrame(raf);\n  window.removeEventListener(\"lab:pause\", pauseChanged);\n  removeEventListener(\"resize\", resize);\n  canvas.removeEventListener(\"pointermove\", move);\n  canvas.removeEventListener(\"pointerdown\", click);\n  canvas.removeEventListener(\"pointerleave\", leave);\n});\n"
    },
    {
      "path": "parameters.json",
      "content": "[\n  {\n    \"id\": \"color\",\n    \"binding\": \"color\",\n    \"label\": \"Color\",\n    \"value\": \"#49ff9c\",\n    \"defaultValue\": \"#49ff9c\",\n    \"widget\": \"color\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"count\",\n    \"binding\": \"count\",\n    \"label\": \"Límite de partículas\",\n    \"value\": 160,\n    \"defaultValue\": 160,\n    \"widget\": \"slider\",\n    \"min\": 40,\n    \"max\": 240,\n    \"step\": 10,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"size\",\n    \"binding\": \"size\",\n    \"label\": \"Tamaño de partícula (px)\",\n    \"value\": 0.7,\n    \"defaultValue\": 0.7,\n    \"widget\": \"slider\",\n    \"min\": 0.35,\n    \"max\": 1.2,\n    \"step\": 0.05,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"life\",\n    \"binding\": \"life\",\n    \"label\": \"Duración de la estela (s)\",\n    \"value\": 1.5,\n    \"defaultValue\": 1.5,\n    \"widget\": \"slider\",\n    \"min\": 0.4,\n    \"max\": 3,\n    \"step\": 0.1,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"spread\",\n    \"binding\": \"spread\",\n    \"label\": \"Dispersión de la estela\",\n    \"value\": 10,\n    \"defaultValue\": 10,\n    \"widget\": \"slider\",\n    \"min\": 2,\n    \"max\": 28,\n    \"step\": 1,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"drift\",\n    \"binding\": \"drift\",\n    \"label\": \"Movimiento suave\",\n    \"value\": 8,\n    \"defaultValue\": 8,\n    \"widget\": \"slider\",\n    \"min\": 0,\n    \"max\": 25,\n    \"step\": 1,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"glow\",\n    \"binding\": \"glow\",\n    \"label\": \"Glow suave de las partículas\",\n    \"value\": 0.5,\n    \"defaultValue\": 0.5,\n    \"widget\": \"slider\",\n    \"min\": 0,\n    \"max\": 1,\n    \"step\": 0.05,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"intensity\",\n    \"binding\": \"intensity\",\n    \"label\": \"Luminosidad\",\n    \"value\": 0.9,\n    \"defaultValue\": 0.9,\n    \"widget\": \"slider\",\n    \"min\": 0.2,\n    \"max\": 1,\n    \"step\": 0.05,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"ripples\",\n    \"binding\": \"ripples\",\n    \"label\": \"Ondas al hacer clic\",\n    \"value\": true,\n    \"defaultValue\": true,\n    \"widget\": \"toggle\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"waveSpeed\",\n    \"binding\": \"waveSpeed\",\n    \"label\": \"Velocidad de la onda\",\n    \"value\": 190,\n    \"defaultValue\": 190,\n    \"widget\": \"slider\",\n    \"min\": 80,\n    \"max\": 350,\n    \"step\": 10,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"waveForce\",\n    \"binding\": \"waveForce\",\n    \"label\": \"Movimiento causado por la onda\",\n    \"value\": 12,\n    \"defaultValue\": 12,\n    \"widget\": \"slider\",\n    \"min\": 0,\n    \"max\": 25,\n    \"step\": 1,\n    \"source\": \"code\"\n  }\n]"
    }
  ],
  "composition": {
