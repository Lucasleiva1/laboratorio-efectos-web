      "widget": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "source": "code",
      "group": "Fondo de imagen"
    },
    {
      "id": "dim",
      "binding": "dim",
      "label": "Oscurecimiento",
      "value": 0.25,
      "defaultValue": 0.25,
      "widget": "slider",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "source": "code",
