{
  "formatVersion": 1,
  "id": "06-image-displacement",
  "name": "Fluido · Imagen y distorsión",
  "createdAt": "2026-11-10T00:00:00Z",
  "modifiedAt": "2026-11-10T00:00:00Z",
  "profile": "html",
  "entry": "index.html",
  "parameters": [
    {
      "id": "strength",
      "label": "Fuerza de distorsión",
      "widget": "slider",
      "binding": "strength",
      "source": "code",
      "value": 35,
      "defaultValue": 35,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "duration",
      "label": "Duración de transición",
      "widget": "slider",
      "binding": "duration",
      "source": "code",
      "value": 1,
      "defaultValue": 1,
      "min": 0.1,
      "max": 3,
      "step": 0.1
    }
  ],
  "dependencies": [
    "pixi.js",
    "gsap"
  ],
  "tags": [],
  "description": "Fluido · Imagen y distorsión",
  "files": [
    {
      "path": "index.html",
      "content": "<script type=\"module\" src=\"main.js\"></script>"
    },
    {
      "path": "main.js",
      "content": "import{Application,Assets,Sprite,Texture,DisplacementFilter}from'pixi.js';import{gsap}from'gsap';import image from'./art.svg';import schema from'./parameters.json';\n(async()=>{const app=new Application();await app.init({resizeTo:window,background:'#09070f',preference:'webgl',antialias:true});document.body.append(app.canvas);const texture=await Assets.load(image);const picture=new Sprite(texture);app.stage.addChild(picture);const map=document.createElement('canvas');map.width=256;map.height=256;const c=map.getContext('2d');const g=c.createRadialGradient(128,128,0,128,128,128);g.addColorStop(0,'#ff8080');g.addColorStop(1,'#808080');c.fillStyle=g;c.fillRect(0,0,256,256);const displacement=new Sprite(Texture.from(map));displacement.anchor.set(.5);displacement.x=innerWidth/2;displacement.y=innerHeight/2;app.stage.addChild(displacement);const filter=new DisplacementFilter({sprite:displacement,scale:25});picture.filters=[filter];let p={};window.lab.register(schema,v=>{p=v;filter.scale.set(v.strength);});const resize=()=>{picture.scale.set(Math.min(innerWidth/1200,innerHeight/800));picture.x=(innerWidth-picture.width)/2;picture.y=(innerHeight-picture.height)/2;};resize();addEventListener('resize',resize);addEventListener('pointermove',e=>{displacement.x=e.clientX;displacement.y=e.clientY;});picture.alpha=0;gsap.to(picture,{alpha:1,duration:1.5});addEventListener('click',()=>gsap.fromTo(picture,{alpha:.2},{alpha:1,duration:p.duration}));app.ticker.add(()=>{if(!window.lab.paused)displacement.rotation+=.005;});window.lab.onDispose(()=>{gsap.killTweensOf(picture);app.destroy(true,{children:true,texture:true});});})();"
    },
    {
      "path": "parameters.json",
      "content": "[\n  {\n    \"id\": \"strength\",\n    \"label\": \"Fuerza de distorsión\",\n    \"widget\": \"slider\",\n    \"binding\": \"strength\",\n    \"source\": \"code\",\n    \"value\": 35,\n    \"defaultValue\": 35,\n    \"min\": 0,\n    \"max\": 100,\n    \"step\": 1\n  },\n  {\n    \"id\": \"duration\",\n    \"label\": \"Duración de transición\",\n    \"widget\": \"slider\",\n    \"binding\": \"duration\",\n    \"source\": \"code\",\n    \"value\": 1,\n    \"defaultValue\": 1,\n    \"min\": 0.1,\n    \"max\": 3,\n    \"step\": 0.1\n  }\n]"
    },
    {
      "path": "art.svg",
      "content": "data:image/svg+xml;base64,"
    }
  ]
}