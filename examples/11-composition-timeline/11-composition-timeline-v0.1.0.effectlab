  "files": [
    {
      "path": "main.tsx",
      "content": "import React,{useState,useEffect} from 'react';import{createRoot}from'react-dom/client';import schema from './parameters.json';import './style.css';\nfunction App(){const[p,setP]=useState(()=>window.lab.register(schema));const[count,setCount]=useState(0);useEffect(()=>window.lab.onChange(setP),[]);return <main><span>REACT + TYPESCRIPT / 002</span><div className=\"orb\" style={{background:p.color,animationDuration:(4/Number(p.speed))+'s'}}/><h1>Ideas en órbita.</h1><p>Estado real. Código editable. Posibilidades abiertas.</p><button onClick={()=>setCount(count+1)}>Experimentar · {count}</button></main>}\nconst root=createRoot(document.getElementById('root')!);root.render(<App/>);window.lab.onDispose(()=>root.unmount());"
    },
    {
      "path": "style.css",
      "content": "body{background:#09070f;color:#f7f2ff;font-family:system-ui;margin:0}main{text-align:center;padding:12vh 25px}main>span{font-size:9px;letter-spacing:.2em;color:#b095ff}.orb{width:140px;height:140px;margin:45px auto;border-radius:50%;box-shadow:inset -25px -25px 40px #0009,0 0 80px #8b5cf650;animation:float 4s ease-in-out infinite}h1{font-size:35px;letter-spacing:-.05em}p{font-size:12px;color:#a89bb9}button{background:#8b5cf6;border:1px solid #b095ff80;padding:12px 22px;border-radius:25px;color:white;cursor:pointer}@keyframes float{50%{transform:translateY(-20px) rotate(10deg)}}"
    },
    {
      "path": "parameters.json",
      "content": "[\n  {\n    \"id\": \"speed\",\n    \"label\": \"Velocidad\",\n    \"widget\": \"slider\",\n    \"value\": 1,\n    \"defaultValue\": 1,\n    \"min\": 0.2,\n    \"max\": 3,\n    \"step\": 0.1,\n    \"binding\": \"speed\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"color\",\n    \"label\": \"Color\",\n    \"widget\": \"color\",\n    \"value\": \"#8b5cf6\",\n    \"defaultValue\": \"#8b5cf6\",\n    \"step\": 1,\n    \"binding\": \"color\",\n    \"source\": \"code\"\n  }\n]"
    }
