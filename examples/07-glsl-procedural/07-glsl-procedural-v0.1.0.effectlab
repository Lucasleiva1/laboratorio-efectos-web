      "value": 1,
      "defaultValue": 1,
      "min": 0,
      "max": 2,
      "step": 0.05
    },
    {
      "id": "frequency",
      "label": "Frecuencia",
      "widget": "slider",
      "binding": "frequency",
      "source": "code",
      "value": 4,
      "defaultValue": 4,
      "min": 1,
      "max": 12,
      "step": 0.1
    }
  ],
  "dependencies": [],
  "tags": [],
  "description": "Aurora · Shader procedural",
  "files": [
    {
      "path": "index.html",
      "content": "<script type=\"module\" src=\"main.js\"></script>"
    },
    {
      "path": "main.js",
      "content": "import fragment from'./aurora.frag';import schema from'./parameters.json';\nconst canvas=document.createElement('canvas');document.body.append(canvas);document.body.style.cssText='margin:0;background:#09070f;overflow:hidden';const gl=canvas.getContext('webgl2');if(!gl)throw Error('WebGL2 no disponible en este equipo');\nfunction shader(type,source){const s=gl.createShader(type);gl.shaderSource(s,source);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw Error(gl.getShaderInfoLog(s));return s;}const vertex=shader(gl.VERTEX_SHADER,'#version 300 es\\nin vec2 position;void main(){gl_Position=vec4(position,0.,1.);}');const frag=shader(gl.FRAGMENT_SHADER,fragment);const program=gl.createProgram();gl.attachShader(program,vertex);gl.attachShader(program,frag);gl.linkProgram(program);if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error(gl.getProgramInfoLog(program));gl.useProgram(program);const buffer=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,buffer);gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);const position=gl.getAttribLocation(program,'position');gl.enableVertexAttribArray(position);gl.vertexAttribPointer(position,2,gl.FLOAT,false,0,0);const u={};for(const name of ['time','resolution','mouse','intensity','frequency'])u[name]=gl.getUniformLocation(program,name);let p={};window.lab.register(schema,v=>p=v);let mouse=[.5,.5],clock=0,last=0;addEventListener('pointermove',e=>mouse=[e.clientX/innerWidth,1-e.clientY/innerHeight]);function draw(t){if(!window.lab.paused)clock+=(t-last)/1000;last=t;const dpr=Math.min(devicePixelRatio,1.5);canvas.width=innerWidth*dpr;canvas.height=innerHeight*dpr;canvas.style.cssText='width:100vw;height:100vh;display:block';gl.viewport(0,0,canvas.width,canvas.height);gl.uniform1f(u.time,clock);gl.uniform2f(u.resolution,canvas.width,canvas.height);gl.uniform2f(u.mouse,...mouse);gl.uniform1f(u.intensity,p.intensity);gl.uniform1f(u.frequency,p.frequency);gl.drawArrays(gl.TRIANGLES,0,3);raf=requestAnimationFrame(draw);}let raf=requestAnimationFrame(draw);window.lab.onDispose(()=>{cancelAnimationFrame(raf);gl.deleteBuffer(buffer);gl.deleteProgram(program);gl.deleteShader(vertex);gl.deleteShader(frag);});"
    },
    {
      "path": "parameters.json",
      "content": "[\n  {\n    \"id\": \"intensity\",\n    \"label\": \"Intensidad\",\n    \"widget\": \"slider\",\n    \"binding\": \"intensity\",\n    \"source\": \"code\",\n    \"value\": 1,\n    \"defaultValue\": 1,\n    \"min\": 0,\n    \"max\": 2,\n    \"step\": 0.05\n  },\n  {\n    \"id\": \"frequency\",\n    \"label\": \"Frecuencia\",\n    \"widget\": \"slider\",\n    \"binding\": \"frequency\",\n    \"source\": \"code\",\n    \"value\": 4,\n    \"defaultValue\": 4,\n    \"min\": 1,\n    \"max\": 12,\n    \"step\": 0.1\n  }\n]"
    },
    {
      "path": "aurora.frag",
      "content": "#version 300 es\nprecision highp float;\nuniform float time;uniform vec2 resolution;uniform vec2 mouse;uniform float intensity;uniform float frequency;out vec4 color;\nvoid main(){vec2 uv=gl_FragCoord.xy/resolution;vec2 p=uv-.5;p.x*=resolution.x/resolution.y;float waves=0.;for(float i=1.;i<5.;i++){float y=sin(p.x*frequency+i+time*.25)*.18+sin(p.x*frequency*.5-time*.2)*.1;waves+=.012/(abs(p.y-y+(i-2.)*.055)+.012);}vec3 base=vec3(.035,.025,.06);vec3 glow=mix(vec3(.32,.12,.8),vec3(.5,.9,.8),uv.x+mouse.x*.2);float vignette=1.-smoothstep(.1,.8,length(p));color=vec4(base+glow*waves*intensity*vignette,1.);}"
    }
  ]
}