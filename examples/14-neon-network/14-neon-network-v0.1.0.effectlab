          "files": [
            {
              "path": "index.html",
              "content": "<canvas id=\"network\" aria-label=\"Red tecnológica interactiva\"></canvas><link rel=\"stylesheet\" href=\"style.css\"><script type=\"module\" src=\"main.js\"></script>"
            },
            {
              "path": "style.css",
              "content": "html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#050e0c}canvas{display:block;width:100%;height:100%;touch-action:none}"
            },
            {
              "path": "main.js",
              "content": "import schema from \"./parameters.json\";\nconst canvas = document.querySelector(\"canvas\"),\n  ctx = canvas.getContext(\"2d\");\nlet p = {},\n  w = 1,\n  h = 1;\nfunction draw() {\n  w = innerWidth;\n  h = innerHeight;\n  const dpr = Math.min(devicePixelRatio || 1, 1.5);\n  canvas.width = w * dpr;\n  canvas.height = h * dpr;\n  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  ctx.strokeStyle = p.gridColor;\n  ctx.fillStyle = p.gridColor;\n  ctx.lineWidth = 0.6;\n  ctx.globalAlpha = p.gridOpacity;\n  for (let x = 0; x < w; x += p.gridSize) {\n    ctx.beginPath();\n    ctx.moveTo(x, 0);\n    ctx.lineTo(x, h);\n    ctx.stroke();\n    for (let y = 0; y < h; y += p.gridSize) ctx.fillRect(x - 1, y - 1, 2, 2);\n  }\n  for (let y = 0; y < h; y += p.gridSize) {\n    ctx.beginPath();\n    ctx.moveTo(0, y);\n    ctx.lineTo(w, y);\n    ctx.stroke();\n  }\n}\nwindow.lab.register(schema, (value) => {\n  p = value;\n  document.body.style.background = p.background;\n  draw();\n});\naddEventListener(\"resize\", draw);\nwindow.lab.onDispose(() => removeEventListener(\"resize\", draw));\n"
            },
            {
              "path": "parameters.json",
              "content": "[\n  {\n    \"id\": \"background\",\n    \"binding\": \"background\",\n    \"label\": \"Color de fondo\",\n    \"value\": \"#050e0c\",\n    \"defaultValue\": \"#050e0c\",\n    \"widget\": \"color\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"gridColor\",\n    \"binding\": \"gridColor\",\n    \"label\": \"Color de la retícula\",\n    \"value\": \"#17734e\",\n    \"defaultValue\": \"#17734e\",\n    \"widget\": \"color\",\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"gridOpacity\",\n    \"binding\": \"gridOpacity\",\n    \"label\": \"Visibilidad de la retícula\",\n    \"value\": 0.14,\n    \"defaultValue\": 0.14,\n    \"widget\": \"slider\",\n    \"min\": 0,\n    \"max\": 0.5,\n    \"step\": 0.01,\n    \"source\": \"code\"\n  },\n  {\n    \"id\": \"gridSize\",\n    \"binding\": \"gridSize\",\n    \"label\": \"Separación de la retícula\",\n    \"value\": 64,\n    \"defaultValue\": 64,\n    \"widget\": \"slider\",\n    \"min\": 24,\n    \"max\": 140,\n    \"step\": 4,\n    \"source\": \"code\"\n  }\n]"
            }
          ]
