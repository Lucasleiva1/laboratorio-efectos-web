  "formatVersion": 1,
  "id": "01-cursor-halo-html",
  "name": "Halo · Luz que te sigue",
  "createdAt": "2026-11-10T00:00:00Z",
  "modifiedAt": "2026-11-10T00:00:00Z",
  "profile": "html",
  "entry": "index.html",
  "parameters": [
    {
      "id": "size",
      "label": "Tamaño",
      "widget": "slider",
      "value": 180,
      "defaultValue": 180,
      "min": 40,
      "max": 500,
      "step": 1,
      "binding": "size",
      "source": "code"
    },
    {
      "id": "color",
      "label": "Color",
      "widget": "color",
      "value": "#8b5cf6",
      "defaultValue": "#8b5cf6",
      "step": 1,
      "binding": "color",
      "source": "code"
    },
    {
      "id": "enabled",
      "label": "Interacción",
      "widget": "toggle",
      "value": true,
      "defaultValue": true,
      "step": 1,
      "binding": "enabled",
      "source": "code"
