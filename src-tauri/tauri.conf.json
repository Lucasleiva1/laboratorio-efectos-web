{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Effect Lab",
  "version": "0.2.0",
  "identifier": "com.effectlab.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EFFECT LAB · Laboratorio de efectos web",
        "width": 1520,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'nonce-effectlab-preview' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob: ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; worker-src 'self' blob:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Laboratorio de efectos web premium",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Spanish"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RTY4MzdERjM5RUFGNjAKUldSZ3I1N3pmWVBtR0xSUnRlZUtDaHlsKzBTR0h4WHVyLzR0QXFwODByQzdkb0NNYkpVZXpaTDYK",
      "endpoints": [
        "https://github.com/Lucasleiva1/laboratorio-efectos-web/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
